# =====================================================================
# Variáveis de Ambiente - Sistema de Oficina Mecânica (Tech Challenge)
# =====================================================================

# ---------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# ---------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/mecanica
SPRING_DATASOURCE_USERNAME=mecanica
SPRING_DATASOURCE_PASSWORD=mecanica

# ---------------------------------------------------------------------
# AUTENTICAÇÃO JWT
# ---------------------------------------------------------------------
JWT_SECRET=2hub0pa0lzMheKg7yF_yfQa-4O2Zrj8vsFb1-K9aqsxzcvY9U56cmxER2KveU9B5
JWT_EXPIRATION=86400000

# ---------------------------------------------------------------------
# APLICAÇÃO E LINKS DE AÇÃO
# ---------------------------------------------------------------------
APP_BASE_URL=http://localhost:8080
APP_MAIL_FROM=notificacoes@mecanica.com

# ---------------------------------------------------------------------
# CONFIGURAÇÃO DE E-MAIL (SMTP)
# ---------------------------------------------------------------------

# --- OPÇÃO 1: MAILPIT LOCAL (Padrão para Docker Compose - Sem credenciais) ---
# O Mailpit sobe junto com o Docker Compose e captura todos os e-mails enviados.
# Acesse a caixa de entrada em: http://localhost:8025
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# --- OPÇÃO 2: GMAIL COM SENHA DE APLICATIVO (App Password) ---
# Caso deseje enviar e-mails reais via Gmail, descomente as linhas abaixo
# e configure sua conta do Google com "Senha de Aplicativo":
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=seu-email@gmail.com
# SPRING_MAIL_PASSWORD=sua-senha-de-app-16-digitos
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- OPÇÃO 3: SENDGRID (Free Tier) ---
# SPRING_MAIL_HOST=smtp.sendgrid.net
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=apikey
# SPRING_MAIL_PASSWORD=sua-chave-api-sendgrid
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
